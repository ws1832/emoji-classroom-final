# FastAPI/Tortoise 后端使用的 MySQL 连接配置。
# 请复制为 .env，并把用户名、密码和数据库名修改为自己的配置。
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=请修改为自己的MySQL用户名
MYSQL_PASSWORD=请修改为自己的MySQL密码
MYSQL_DATABASE=emoji_classroom
MYSQL_CHARSET=utf8mb4
# 单机开发默认自动迁移；多副本部署先执行 python scripts/migrate.py 再关闭。
AUTO_INIT_DB=true
DEBUG=true
# 生产 DEBUG=false 时设置随机 SECRET_KEY 和强 BOOTSTRAP_ADMIN_PASSWORD。
# BOOTSTRAP_ADMIN_PASSWORD=请设置强密码
# CORS_ORIGINS=["https://你的课堂域名"]
# SECRET_KEY_FILE=/run/secrets/jwt
# MYSQL_PASSWORD_FILE=/run/secrets/mysql_password
# 管理员注册独立AI服务身份后填写其ID；不是学生ID或摄像头索引。
# AI_BROWSER_DEVICE_ID=2
AI_BROWSER_UPLOAD_URL=/ai-stream/frames
